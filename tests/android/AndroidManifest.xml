<?xml version="1.0" encoding="utf-8"?>
<!-- A NativeActivity with no Java code: the whole app is lifecycle.cpp. Made
     debuggable so the test can read app-private storage with `run-as`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="io.sub0log.lifecycle">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="Sub0Log lifecycle"
                 android:hasCode="false"
                 android:extractNativeLibs="true">
        <!-- singleTask: relaunching brings this instance back (resume) rather
             than stacking a second NativeActivity, and with it a second
             android_main, in the same process, which is what the default
             launch mode does for an explicit am start -n. (No double hyphens
             anywhere in XML comments: they are not well-formed.) -->
        <activity android:name="android.app.NativeActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="sub0log_lifecycle" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
